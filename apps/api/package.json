    "hono": "^4.6.12",
    "nanoid": "^5.0.9",
    "otpauth": "^9.3.4",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
